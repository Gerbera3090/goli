# API
API_PORT=4000
TRUST_PROXY_HOPS=0

# Anonymous link creation limit
LINK_CREATE_RATE_LIMIT_MAX=20
LINK_CREATE_RATE_LIMIT_WINDOW_SECONDS=60

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=goli
DB_USER=goli
DB_PASSWORD=goli

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=replace-me
REDIS_LINK_TTL_SECONDS=120

# Next.js server -> NestJS
API_INTERNAL_URL=http://127.0.0.1:4000

# Public short-link origins (build and deployment)
PUBLIC_WEB_ORIGIN=https://gori.bera.page
ALTERNATE_WEB_ORIGIN=
