{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["ALTERNATE_WEB_ORIGIN", "API_INTERNAL_URL", "PUBLIC_WEB_ORIGIN"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "ALTERNATE_WEB_ORIGIN",
        "API_INTERNAL_URL",
        "API_PORT",
        "DB_HOST",
        "DB_NAME",
        "DB_PASSWORD",
        "DB_PORT",
        "DB_USER",
        "LINK_CREATE_RATE_LIMIT_MAX",
        "LINK_CREATE_RATE_LIMIT_WINDOW_SECONDS",
        "PORT",
        "PUBLIC_WEB_ORIGIN",
        "REDIS_HOST",
        "REDIS_LINK_TTL_SECONDS",
        "REDIS_PORT",
        "TRUST_PROXY_HOPS"
      ],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
